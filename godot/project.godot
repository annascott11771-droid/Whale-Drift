; Engine configuration file.
; Whale Drift — Godot 4.7 project (code-only repository)

config_version=5

[application]

config/name="Whale Drift"
config/description="Whale Drift — an endless underwater runner"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.004, 0.035, 0.066, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.004, 0.035, 0.066, 1)

[audio]

driver/enable_input=false
